# Copy to .env and export, or set these in the environment.
#
# The Gemini API key is only needed for the live agent. The offline demo, the
# deterministic checks and the whole test suite run without it.
GOOGLE_API_KEY=

# Model the ADK agent runs on. Any Gemini model name supported by genai.
ADK_MODEL=gemini-flash-latest

# Directory holding the tracker. Each project is one JSON file; proposals and
# the audit trail live in subdirectories. Defaults to ./data.
PIPELINE_DATA_DIR=./data

# Address the web app listens on.
PIPELINE_ADDR=127.0.0.1:8080

# Use the deterministic scripted model instead of Gemini. Requires no key and
# produces the same review every time; this is what `pipeline demo` uses.
PIPELINE_SCRIPTED_MODEL=false

# Days after the due date that a milestone becomes critical.
PIPELINE_CRITICAL_OVERDUE_DAYS=30

# Days without an update after which an open milestone is reported as stalled.
PIPELINE_STALLED_AFTER_DAYS=14
